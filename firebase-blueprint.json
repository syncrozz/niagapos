{
  "entities": {
    "Store": {
      "title": "Store",
      "description": "Store configuration, currency, and retail settings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "currency": { "type": "string" },
        "tagline": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "receiptFooter": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "code", "currency"]
    },
    "Product": {
      "title": "Product",
      "description": "Retail product catalog item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "storeId": { "type": "string" },
        "sku": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "costPrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "currentStock": { "type": "number" },
        "minimumStock": { "type": "number" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "sku", "name", "costPrice", "sellingPrice", "currentStock", "active"]
    },
    "InventoryMovement": {
      "title": "InventoryMovement",
      "description": "Stock movement audit ledger record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "storeId": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "type": { "type": "string", "enum": ["STOCK_IN", "SALE", "ADJUSTMENT", "RETURN"] },
        "quantity": { "type": "number" },
        "previousStock": { "type": "number" },
        "newStock": { "type": "number" },
        "reason": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "productId", "type", "quantity", "previousStock", "newStock", "reason", "createdAt"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Completed POS checkout transaction and revenue record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "storeId": { "type": "string" },
        "transactionNumber": { "type": "string" },
        "dateTime": { "type": "string" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "total": { "type": "number" },
        "totalCost": { "type": "number" },
        "grossProfit": { "type": "number" },
        "status": { "type": "string", "enum": ["COMPLETED", "REFUNDED", "VOID"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "transactionNumber", "total", "totalCost", "grossProfit", "status"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Product vendor / supplier record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "supplierCode": { "type": "string" },
        "supplierName": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "supplierCode", "supplierName", "active"]
    },
    "Purchase": {
      "title": "Purchase",
      "description": "Purchase order and stock acquisition record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "purchaseNumber": { "type": "string" },
        "supplierId": { "type": "string" },
        "supplierCodeSnapshot": { "type": "string" },
        "supplierNameSnapshot": { "type": "string" },
        "purchaseDate": { "type": "string" },
        "status": { "type": "string", "enum": ["DRAFT", "COMPLETED", "CANCELLED"] },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "total": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "purchaseNumber", "supplierId", "status", "total"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Store customer profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerCode": { "type": "string" },
        "customerName": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "customerCode", "customerName", "active"]
    },
    "LoyaltyLedgerEntry": {
      "title": "LoyaltyLedgerEntry",
      "description": "Customer loyalty reward points ledger entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "points": { "type": "number" },
        "type": { "type": "string", "enum": ["EARNED", "REDEEMED", "ADJUSTMENT"] },
        "referenceId": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "customerId", "points", "type", "referenceId", "createdAt"]
    },
    "StaffUser": {
      "title": "StaffUser",
      "description": "Staff account and access role",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userCode": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["OWNER", "MANAGER", "CASHIER", "INVENTORY_STAFF"] },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userCode", "name", "role", "active"]
    }
  },
  "firestore": {
    "/stores/{storeId}": {
      "schema": "Store",
      "description": "Store profiles and retail settings"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Product catalog entries"
    },
    "/inventory_movements/{movementId}": {
      "schema": "InventoryMovement",
      "description": "Audit trail for all stock movements"
    },
    "/sales/{saleId}": {
      "schema": "Sale",
      "description": "Completed POS checkout transactions"
    },
    "/suppliers/{supplierId}": {
      "schema": "Supplier",
      "description": "Active and inactive supplier records"
    },
    "/purchases/{purchaseId}": {
      "schema": "Purchase",
      "description": "Purchase orders and supplier receiving"
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Store customers and loyalty membership"
    },
    "/loyalty_ledger/{ledgerId}": {
      "schema": "LoyaltyLedgerEntry",
      "description": "Points transaction ledger"
    },
    "/staff_users/{staffId}": {
      "schema": "StaffUser",
      "description": "Staff roster and access roles"
    }
  }
}
